# Shared Environment Variables

# -----------------
# Backend Variables
# -----------------

# CORS — allowed frontend origin (required for network access)
# Default: http://localhost:3000
# For network access, set to your machine's IP:
# FRONTEND_ORIGIN=http://192.168.1.100:3000
# To allow all origins (development only):
# CORS_ALLOW_ALL=true

# Google Gemini (Default)
GOOGLE_API_KEY=""

# OpenAI ChatGPT (Optional)
OPENAI_API_KEY=""

# Anthropic Claude (Optional)
ANTHROPIC_API_KEY=""

# Speckle (Upload 3d models into Immersive Models project)
SPECKLE_TOKEN="e73122e4576a2f646f72666344c19d2a26e819a22b"

# ------------------
# Frontend Variables
# Next.js needs variables to be prefixed with NEXT_PUBLIC_ to be available in the browser 
NEXT_PUBLIC_ELEVENLABS_API_KEY=""

# API Base URL — optional manual override (leave unset for auto-detection)
# The frontend auto-detects the API URL from the browser's hostname:
#   localhost → http://localhost:8000
#   network IP → http://<same-IP>:8000

# Uncomment to override:
# NEXT_PUBLIC_API_BASE_URL= http://192.168.2.35:8000
# FRONTEND_ORIGIN=http://192.168.2.35:3000


